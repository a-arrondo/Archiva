{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.2.0",
  "description": "__MSG_extDesc__",
  "default_locale": "en",
  "permissions": ["activeTab", "storage", "contextMenus"],
  "icons": {
    "16": "./icons/icon16.png",
    "64": "./icons/icon64.png",
    "128": "./icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "./icons/icon16.png",
      "64": "./icons/icon64.png",
      "128": "./icons/icon128.png"
    },
    "default_title": "__MSG_extTitle__"
  },
  "commands": {
    "archive-tab": {
      "suggested_key": {
        "default": "Ctrl+Shift+Z"
      },
      "description": "__MSG_cmdArchiveTab__"
    }
  }
}