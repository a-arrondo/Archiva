{
  "manifest_version": 3,
  "name": "ArchiveIt",
  "version": "1.0",
  "description": "Opens the current page in Archive.today with a single click.",
  "permissions": ["activeTab", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "./icons/icon16.png",
      "64": "./icons/icon64.png",
      "128": "./icons/icon128.png"
    },
    "default_title": "Open in Archive.today"
  }
}